# ---------------------------------------------------------------- required
# Google AI Studio key: https://aistudio.google.com/apikey  (used for answers AND embeddings)
GEMINI_API_KEY=

# ---------------------------------------------------------------- deployment
TALKDOX_ENV=development            # set to "production" on a public server (enables strict checks)
CORS_ORIGINS=http://localhost:5173 # comma separated list of frontend origins; "*" is refused in production
DATA_DIR=./data                    # SQLite database + temp uploads live here (mount a persistent volume)
# SECRET_KEY=                      # signs workspace tokens; auto-generated into DATA_DIR/.secret_key if unset.
                                   # Set explicitly if you run more than one instance.
RETENTION_DAYS=30                  # workspaces idle this long are deleted with all their data (0 = keep forever)

# ---------------------------------------------------------------- models (never silently switched)
GEMINI_MODEL=gemini-2.5-flash      # verify availability at https://ai.google.dev/gemini-api/docs/deprecations
# GEMINI_FALLBACK_MODEL=           # optional: used (and reported in every response) only if the primary returns 404
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768                  # changing this requires re-adding sources
# GROQ_API_KEY=                    # optional alternative LLM provider (LLM_PROVIDER=groq)

# ---------------------------------------------------------------- YouTube
# SUPADATA_API_KEY=                # transcript fallback; helps when YouTube blocks datacenter IPs
# YOUTUBE_API_KEY=                 # official Data API: titles/chapters/playlists
# YOUTUBE_PROXY_URL=               # http(s) proxy for youtube-transcript-api / yt-dlp
# ENABLE_GEMINI_VIDEO_FALLBACK=0   # last resort for videos without captions (model-generated, costs tokens)

# ---------------------------------------------------------------- web
# ENABLE_JS_RENDER=0               # needs requirements-js.txt + Chromium; see docs/SECURITY.md
# CRAWL_MAX_PAGES=50
# RESPECT_ROBOTS=1

# ---------------------------------------------------------------- limits
# MAX_UPLOAD_MB=25
# MAX_PDF_PAGES=1000
# MAX_SOURCES_PER_WORKSPACE=40
# RATE_CHAT_PER_MIN=20
