{
  "name": "TalkDox",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": { "ghcr.io/devcontainers/features/node:1": { "version": "22" } },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python", "dbaeumer.vscode-eslint"] }
  },
  "postCreateCommand": "pip install -r backend/requirements-dev.txt && cd frontend && npm ci",
  "forwardPorts": [5173, 8000]
}
